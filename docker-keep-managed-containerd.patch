+// managedContainerdMetadata reports whether root holds a containerd
+// metadata database written by a dockerd-managed containerd. Containers
+// created by that daemon are recorded there, not in the system containerd.
+func managedContainerdMetadata(root string) bool {
+	fi, err := os.Stat(filepath.Join(root, "io.containerd.metadata.v1.bolt", "meta.db"))
+	return err == nil && fi.Mode().IsRegular()
+}
