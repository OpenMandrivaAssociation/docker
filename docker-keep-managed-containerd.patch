+func TestManagedContainerdMetadata(t *testing.T) {
+	root := t.TempDir()
+	assert.Check(t, !managedContainerdMetadata(root))
+
+	db := filepath.Join(root, "io.containerd.metadata.v1.bolt", "meta.db")
+	assert.NilError(t, os.MkdirAll(filepath.Dir(db), 0o700))
+	assert.NilError(t, os.WriteFile(db, []byte("db"), 0o600))
+	assert.Check(t, managedContainerdMetadata(root))
+
+	assert.NilError(t, os.Remove(db))
+	assert.NilError(t, os.Mkdir(db, 0o700))
+	assert.Check(t, !managedContainerdMetadata(root))
+}
